@model mf_dev_backend_2023.Models.Veiculo

@{
    ViewData["Title"] = "Delete";
}

<h1>Remover um Veículo</h1>

<h3>tem certeza que deseja remover este registro?</h3>
<div>
    <h4>mf_dev_backend_2023.Models.Veiculo</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Placa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Placa)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
